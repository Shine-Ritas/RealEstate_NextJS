{
  "name": "primeproperty-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract:live": "RUN_LIVE_CONTRACT_TESTS=true vitest run tests/live-contract.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run template:check && npm run check && npm run build",
    "template:check": "node scripts/check-template.mjs",
    "api:sync": "node scripts/sync-api-contract.mjs",
    "api:normalize": "node scripts/normalize-openapi.mjs",
    "api:types": "npm run api:normalize && openapi-typescript docs/api/openapi.codegen.json -o src/lib/api/generated/schema.ts",
    "api:update": "npm run api:sync && npm run api:types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
